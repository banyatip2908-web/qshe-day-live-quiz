{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qshe-day-live-quiz",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-10",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "QuizRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
